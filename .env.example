# ============================================
# donis_finance — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# --- Server ---
APP_PORT=8200
APP_ENV=development
APP_NAME=donis_finance

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=donis_finance
DB_USER=donis_user
DB_PASSWORD=change_me

# --- JWT ---
JWT_SECRET=change_me_to_a_random_string
JWT_ACCESS_EXP_SECONDS=900
JWT_REFRESH_EXP_SECONDS=1209600

# --- SMTP (Mailtrap for dev) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=donis_finance
SMTP_FROM_EMAIL=noreply@donis.finance
SMTP_STARTTLS=true
SMTP_USE_TLS=false

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
